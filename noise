import cv2
import numpy as np
import matplotlib.pyplot as plt
from scipy.ndimage import maximum_filter, minimum_filter

# -----------------------------
# Filters
# -----------------------------
def mean_filter(img, ksize=3):
    result = np.zeros_like(img, dtype=np.float32)
    pad = ksize // 2
    padded = cv2.copyMakeBorder(img, pad, pad, pad, pad, cv2.BORDER_REFLECT)

    for i in range(img.shape[0]):
        for j in range(img.shape[1]):
            region = padded[i:i + ksize, j:j + ksize]
            result[i, j] = np.mean(region)
    return np.clip(result, 0, 255).astype(np.uint8)

def median_filter(img, ksize=3):
    result = np.zeros_like(img, dtype=np.float32)
    pad = ksize // 2
    padded = cv2.copyMakeBorder(img, pad, pad, pad, pad, cv2.BORDER_REFLECT)

    for i in range(img.shape[0]):
        for j in range(img.shape[1]):
            region = padded[i:i + ksize, j:j + ksize]
            result[i, j] = np.median(region)
    return np.clip(result, 0, 255).astype(np.uint8)

def harmonic_filter(img, ksize=3):
    epsilon = 1e-6
    result = np.zeros_like(img, dtype=np.float32)
    pad = ksize // 2
    padded = cv2.copyMakeBorder(img, pad, pad, pad, pad, cv2.BORDER_REFLECT)

    for i in range(img.shape[0]):
        for j in range(img.shape[1]):
            region = padded[i:i + ksize, j:j + ksize]
            result[i, j] = (ksize * ksize) / np.sum(1.0 / (region + epsilon))
    return np.clip(result, 0, 255).astype(np.uint8)

def geometric_filter(img, ksize=3):
    result = np.zeros_like(img, dtype=np.float32)
    pad = ksize // 2
    padded = cv2.copyMakeBorder(img, pad, pad, pad, pad, cv2.BORDER_REFLECT)
    
    for i in range(img.shape[0]):
        for j in range(img.shape[1]):
            region = padded[i:i + ksize, j:j + ksize].astype(np.float32)
            result[i, j] = np.exp(np.mean(np.log(region + 1e-6)))
    return np.clip(result, 0, 255).astype(np.uint8)

def contraharmonic_filter(img, ksize=3, Q=1.5):
    result = np.zeros_like(img, dtype=np.float32)
    pad = ksize // 2
    padded = cv2.copyMakeBorder(img, pad, pad, pad, pad, cv2.BORDER_REFLECT)

    for i in range(img.shape[0]):
        for j in range(img.shape[1]):
            region = padded[i:i + ksize, j:j + ksize].astype(np.float32)
            numerator = np.sum(region ** (Q + 1))
            denominator = np.sum(region ** Q + 1e-6)
            result[i, j] = numerator / denominator
    return np.clip(result, 0, 255).astype(np.uint8)

def gaussian_filter(img, ksize=3, sigma=1.0):
    return cv2.GaussianBlur(img, (ksize, ksize), sigma)

def averaging_filter(img, ksize=3):
    return cv2.blur(img, (ksize, ksize))

def midpoint_filter(img, ksize=3):
    maxf = maximum_filter(img, (ksize, ksize))
    minf = minimum_filter(img, (ksize, ksize))
    midpoint = (maxf + minf) / 2
    return np.clip(midpoint, 0, 255).astype(np.uint8)

# -----------------------------
# Main
# -----------------------------
img = cv2.imread("tree.jpg", cv2.IMREAD_GRAYSCALE)

noisy_titles = ["Gaussian", "Impulse", "Poisson", "Exponential", "Gamma", "Rayleigh", "Uniform",
                "White", "Colored", "Additive", "Multiplicative", "Quantization", "Photon"]

noisy_images = [cv2.imread(f"{title}.png", cv2.IMREAD_GRAYSCALE) for title in noisy_titles]

filters = {
    "Mean": mean_filter,
    "Median": median_filter,
    "Harmonic": harmonic_filter,
    "Geometric": geometric_filter,
    "Contraharmonic": contraharmonic_filter,
    "Gaussian": gaussian_filter,
    "Averaging": averaging_filter,
    "Midpoint": midpoint_filter
}

for idx, title in enumerate(noisy_titles):
    noisy_img = noisy_images[idx]
    
    plt.figure(figsize=(16, 6))
    
    for i, (fname, ffunc) in enumerate(filters.items()):
        filtered_img = ffunc(noisy_img)
        
        plt.subplot(2, 4, i+1)
        plt.imshow(filtered_img, cmap="gray")
        plt.title(f"{fname} Filter")
        plt.axis("off")
    
    plt.suptitle(f"Filters applied to {title} Noise", fontsize=14)
    plt.tight_layout()
