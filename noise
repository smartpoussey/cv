    plt.title(f"Noisy ({noise_type})")
    plt.axis("off")
    
    plt.subplot(1,3,3)
    plt.imshow(denoised, cmap="gray")
    plt.title("Denoised")
    plt.axis("off")
    
    plt.tight_layout()
    plt.show()
