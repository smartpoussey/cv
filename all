def unsharp_masking(img, ksize=3, amount=1.0):
    """
    Unsharp Masking:
    amount: weight of the mask added back to the original
    """
    # Convert to float32 to prevent overflow
    img = img.astype(np.float32)
    
    # Step 1: Low-pass filter (smoothing)
    pad = ksize // 2
    padded = np.pad(img, pad, mode='edge')
    blurred = np.zeros_like(img)
    for i in range(img.shape[0]):
        for j in range(img.shape[1]):
            region = padded[i:i+ksize, j:j+ksize]
            blurred[i,j] = np.mean(region)
    
    # Step 2: Mask = Original - Blurred
    mask = img - blurred
    
    # Step 3: Unsharp masked image
    unsharp = img + amount * mask
    unsharp = np.clip(unsharp, 0, 255).astype(np.uint8)
    
    return blurred.astype(np.uint8), mask.astype(np.uint8), unsharp



