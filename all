def high_boost_filter(img, ksize=3, A=1.5):
    """
    High-Boost Filtering:
    A > 1 => High-boost, A = 1 => Unsharp masking
    """
    # Convert to float32 to prevent overflow/underflow
    img = img.astype(np.float32)
    
    # Step 1: Low-pass filter (smoothing)
    pad = ksize // 2
    padded = np.pad(img, pad, mode='edge')
    blurred = np.zeros_like(img)
    for i in range(img.shape[0]):
        for j in range(img.shape[1]):
            region = padded[i:i+ksize, j:j+ksize]
            blurred[i,j] = np.mean(region)
    
    # Step 2: Mask = Original - Blurred
    mask = img - blurred
    
    # Step 3: High-boost image
    high_boosted = img + (A - 1) * mask
    high_boosted = np.clip(high_boosted, 0, 255).astype(np.uint8)
    
    return blurred.astype(np.uint8), mask.astype(np.uint8), high_boosted


