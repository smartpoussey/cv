import cv2
import numpy as np
import matplotlib.pyplot as plt

input_img = cv2.imread("original_image.jpg", cv2.IMREAD_GRAYSCALE)
target_img = cv2.imread("target_image.png", cv2.IMREAD_GRAYSCALE)


n = 256

input_rk = np.arange(n)
target_rk = np.arange(n)


input_nk, _ = np.histogram(input_img.flatten(), bins=n, range=(0, n))
target_nk, _ = np.histogram(target_img.flatten(), bins=n, range=(0, n))

input_pdf = input_nk/np.sum(input_nk)
input_cdf = np.cumsum(input_pdf)

input_sk_act = input_cdf * (n-1)

input_sk = np.round(input_sk_act, 0).astype(int)

input_new_nk = np.zeros_like(input_nk)

unique_sk = np.unique(input_sk)

for i in unique_sk:
    indices = np.where(input_sk == i)
    input_new_nk[indices] = np.sum(input_nk[indices])


target_pdf = target_nk/np.sum(target_nk)
target_cdf = np.cumsum(target_pdf)

target_sk_act = target_cdf * (n-1)

target_sk = np.round(target_sk_act, 0).astype(int)

target_new_nk = np.zeros_like(target_nk)

unique_sk = np.unique(target_sk)

for i in unique_sk:
    indices = np.where(target_sk == i)
    target_new_nk[indices] = np.sum(target_nk[indices])


mapping = np.zeros(n).astype(int)

for i, sk_val in enumerate(input_sk_act):
    diff = np.abs(sk_val - target_sk_act)
    mapping[i] = target_rk[np.argmin(diff)]

mapped_nk = np.zeros(n).astype(int)

unique_nk = np.unique(mapping)

for i in unique_nk:
    indices = np.where(mapping == i)
    mapped_nk[indices] = np.sum(input_nk[indices])

final_intensity_values = np.zeros(n).astype(int)

for i, j in enumerate(mapping):
    final_intensity_values[j] = mapped_nk[i]
    
matched_img = mapping[input_img]

matched_nk, _ = np.histogram(matched_img.flatten(), bins=n, range=(0, n))
matched_pdf = input_nk/np.sum(input_nk)
matched_cdf = np.cumsum(input_pdf)

