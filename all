# Frequency Domain Helper
# -----------------------------
def frequency_filter(img, H):
    F = np.fft.fft2(img)
    F_shift = np.fft.fftshift(F)
    G = H * F_shift
    g = np.fft.ifft2(np.fft.ifftshift(G))
    return np.clip(np.real(g),0,255).astype(np.uint8)

# -----------------------------
# Frequency Domain Filters
# -----------------------------
def ideal_lowpass(img, D0=30):
    rows, cols = img.shape
    u = np.arange(-rows//2, rows//2)
    v = np.arange(-cols//2, cols//2)
    U,V = np.meshgrid(v,u)
    D = np.sqrt(U**2 + V**2)
    H = np.zeros_like(D)
    H[D<=D0]=1
    return frequency_filter(img,H)

def gaussian_lowpass(img, D0=30):
    rows, cols = img.shape
    u = np.arange(-rows//2, rows//2)
    v = np.arange(-cols//2, cols//2)
    U,V = np.meshgrid(v,u)
    D = np.sqrt(U**2 + V**2)
    H = np.exp(-(D**2)/(2*D0**2))
    return frequency_filter(img,H)

def butterworth_lowpass(img, D0=30, n=2):
    rows, cols = img.shape
    u = np.arange(-rows//2, rows//2)
    v = np.arange(-cols//2, cols//2)
    U,V = np.meshgrid(v,u)
    D = np.sqrt(U**2 + V**2)
    H = 1/(1+(D/D0)**(2*n))
    return frequency_filter(img,H)

def highpass_filter(img, filter_type="butterworth", D0=30, n=2):
    rows, cols = img.shape
    u = np.arange(-rows//2, rows//2)
    v = np.arange(-cols//2, cols//2)
    U,V = np.meshgrid(v,u)
    D = np.sqrt(U**2 + V**2)
    if filter_type=="ideal":
        H = np.ones_like(D)
        H[D<=D0]=0
    elif filter_type=="gaussian":
        H = 1 - np.exp(-(D**2)/(2*D0**2))
    elif filter_type=="butterworth":
        D = np.where(D==0,1e-6,D)
        H = 1/(1 + (D0/D)**(2*n))
    return frequency_filter(img,H)

def bandpass_filter(img, D_low=20, D_high=60, filter_type="butterworth", n=2):
    rows, cols = img.shape
    u = np.arange(-rows//2, rows//2)
    v = np.arange(-cols//2, cols//2)
    U,V = np.meshgrid(v,u)
    D = np.sqrt(U**2 + V**2)
    if filter_type=="ideal":
        H = np.zeros_like(D)
        H[(D>=D_low)&(D<=D_high)] = 1
    elif filter_type=="gaussian":
        H = np.exp(-(D**2)/(2*D_high**2)) - np.exp(-(D**2)/(2*D_low**2))
    elif filter_type=="butterworth":
        D = np.where(D==0,1e-6,D)
        H = 1/(1+(D/D_high)**(2*n)) - 1/(1+(D/D_low)**(2*n))
    return frequency_filter(img,H)

