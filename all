import cv2
import numpy as np
import matplotlib.pyplot as plt
from scipy.ndimage import maximum_filter, minimum_filter

# -----------------------------
# Filters
# -----------------------------
def mean_filter(img, ksize=3):
    result = np.zeros_like(img, dtype=np.float32)
    pad = ksize // 2
    padded = cv2.copyMakeBorder(img, pad, pad, pad, pad, cv2.BORDER_REFLECT)

    for i in range(img.shape[0]):
        for j in range(img.shape[1]):
            region = padded[i:i + ksize, j:j + ksize]
            result[i, j] = np.mean(region)
    return np.clip(result, 0, 255).astype(np.uint8)

def median_filter(img, ksize=3):
    result = np.zeros_like(img, dtype=np.float32)
    pad = ksize // 2
    padded = cv2.copyMakeBorder(img, pad, pad, pad, pad, cv2.BORDER_REFLECT)

    for i in range(img.shape[0]):
        for j in range(img.shape[1]):
            region = padded[i:i + ksize, j:j + ksize]
            result[i, j] = np.median(region)
    return np.clip(result, 0, 255).astype(np.uint8)

def harmonic_filter(img, ksize=3):
    epsilon = 1e-6
    result = np.zeros_like(img, dtype=np.float32)
    pad = ksize // 2
    padded = cv2.copyMakeBorder(img, pad, pad, pad, pad, cv2.BORDER_REFLECT)

    for i in range(img.shape[0]):
        for j in range(img.shape[1]):
            region = padded[i:i + ksize, j:j + ksize]
            result[i, j] = (ksize * ksize) / np.sum(1.0 / (region + epsilon))
    return np.clip(result, 0, 255).astype(np.uint8)

def geometric_filter(img, ksize=3):
    result = np.zeros_like(img, dtype=np.float32)
    pad = ksize // 2
    padded = cv2.copyMakeBorder(img, pad, pad, pad, pad, cv2.BORDER_REFLECT)
    
    for i in range(img.shape[0]):
        for j in range(img.shape[1]):
            region = padded[i:i + ksize, j:j + ksize].astype(np.float32)
            result[i, j] = np.exp(np.mean(np.log(region + 1e-6)))
    return np.clip(result, 0, 255).astype(np.uint8)

def contraharmonic_filter(img, ksize=3, Q=1.5):
    result = np.zeros_like(img, dtype=np.float32)
    pad = ksize // 2
    padded = cv2.copyMakeBorder(img, pad, pad, pad, pad, cv2.BORDER_REFLECT)

    for i in range(img.shape[0]):
        for j in range(img.shape[1]):
            region = padded[i:i + ksize, j:j + ksize].astype(np.float32)
            numerator = np.sum(region ** (Q + 1))
            denominator = np.sum(region ** Q + 1e-6)
            result[i, j] = numerator / denominator
    return np.clip(result, 0, 255).astype(np.uint8)

def gaussian_filter(img, ksize=3, sigma=1.0):
    return cv2.GaussianBlur(img, (ksize, ksize), sigma)

def averaging_filter(img, ksize=3):
    return cv2.blur(img, (ksize, ksize))

def midpoint_filter(img, ksize=3):
    maxf = maximum_filter(img, (ksize, ksize))
    minf = minimum_filter(img, (ksize, ksize))
    midpoint = (maxf + minf) / 2
    return np.clip(midpoint, 0, 255).astype(np.uint8)

# -----------------------------
# Main
# -----------------------------
img = cv2.imread("tree.jpg", cv2.IMREAD_GRAYSCALE)

noisy_titles = ["Gaussian", "Impulse", "Poisson", "Exponential", "Gamma", "Rayleigh", "Uniform",
                "White", "Colored", "Additive", "Multiplicative", "Quantization", "Photon"]

noisy_images = [cv2.imread(f"{title}.png", cv2.IMREAD_GRAYSCALE) for title in noisy_titles]

filters = {
    "Mean": mean_filter,
    "Median": median_filter,
    "Harmonic": harmonic_filter,
    "Geometric": geometric_filter,
    "Contraharmonic": contraharmonic_filter,
    "Gaussian": gaussian_filter,
    "Averaging": averaging_filter,
    "Midpoint": midpoint_filter
}

for idx, title in enumerate(noisy_titles):
    noisy_img = noisy_images[idx]
    
    plt.figure(figsize=(16, 6))
    
    for i, (fname, ffunc) in enumerate(filters.items()):
        filtered_img = ffunc(noisy_img)
        
        plt.subplot(2, 4, i+1)
        plt.imshow(filtered_img, cmap="gray")
        plt.title(f"{fname} Filter")
        plt.axis("off")
    
    plt.suptitle(f"Filters applied to {title} Noise", fontsize=14)
    plt.tight_layout()
    plt.show()


import cv2
import numpy as np
from scipy.ndimage import maximum_filter, minimum_filter
from scipy.stats import skew, kurtosis

def mean_filter(img, ksize=3):
    return cv2.blur(img, (ksize, ksize))

def median_filter(img, ksize=3):
    return cv2.medianBlur(img, ksize)

def harmonic_filter(img, ksize=3):
    epsilon = 1e-6
    padded = cv2.copyMakeBorder(img.astype(np.float32), ksize//2, ksize//2, ksize//2, ksize//2, cv2.BORDER_REFLECT)
    result = np.zeros_like(img, dtype=np.float32)
    for i in range(img.shape[0]):
        for j in range(img.shape[1]):
            region = padded[i:i+ksize, j:j+ksize]
            result[i,j] = (ksize*ksize) / (np.sum(1.0/(region+epsilon)))
    return np.clip(result, 0, 255).astype(np.uint8)

def geometric_filter(img, ksize=3):
    epsilon = 1e-6
    padded = cv2.copyMakeBorder(img.astype(np.float32), ksize//2, ksize//2, ksize//2, ksize//2, cv2.BORDER_REFLECT)
    result = np.zeros_like(img, dtype=np.float32)
    for i in range(img.shape[0]):
        for j in range(img.shape[1]):
            region = padded[i:i+ksize, j:j+ksize]
            result[i,j] = np.exp(np.mean(np.log(region+epsilon)))
    return np.clip(result, 0, 255).astype(np.uint8)

def contraharmonic_filter(img, ksize=3, Q=1.5):
    epsilon = 1e-6
    padded = cv2.copyMakeBorder(img.astype(np.float32), ksize//2, ksize//2, ksize//2, ksize//2, cv2.BORDER_REFLECT)
    result = np.zeros_like(img, dtype=np.float32)
    for i in range(img.shape[0]):
        for j in range(img.shape[1]):
            region = padded[i:i+ksize, j:j+ksize]
            numerator = np.sum(region**(Q+1))
            denominator = np.sum(region**Q + epsilon)
            result[i,j] = numerator / denominator
    return np.clip(result, 0, 255).astype(np.uint8)

def gaussian_filter(img, ksize=3, sigma=1.0):
    return cv2.GaussianBlur(img, (ksize, ksize), sigma)

def averaging_filter(img, ksize=3):
    return cv2.blur(img, (ksize, ksize))

def midpoint_filter(img, ksize=3):
    maxf = maximum_filter(img, (ksize, ksize))
    minf = minimum_filter(img, (ksize, ksize))
    midpoint = (maxf + minf)/2
    return np.clip(midpoint, 0, 255).astype(np.uint8)

def identify_noise(img_noisy, img_original):
    noise = img_noisy.astype(np.float32) - img_original.astype(np.float32)
    mean_val = np.mean(noise)
    std_val = np.std(noise)
    skew_val = skew(noise.flatten())
    kurt_val = kurtosis(noise.flatten())
    
    # Extreme values → Impulse
    if np.max(noise) > 200 or np.min(noise) < -200:
        return "Impulse"
    
    # Uniform noise: roughly flat distribution
    hist, _ = np.histogram(noise.flatten(), bins=50)
    flatness = np.std(hist)
    if flatness < 20:
        return "Uniform"
    
    # Multiplicative noise (high std relative to mean)
    if std_val/np.mean(np.abs(img_original)+1e-6) > 0.5:
        return "Multiplicative"
    
    # Skewed positive → Exponential/Gamma
    if skew_val > 1:
        if mean_val > 20:
            return "Gamma"
        else:
            return "Exponential"
    
    # Low-frequency correlated → Colored
    if std_val > 40 and np.abs(skew_val) < 0.5:
        return "Colored"
    
    # Poisson/Photon → variance ≈ mean
    if np.abs(np.var(noise) - np.mean(img_original)) < 10:
        return "Poisson"
    
    # Additive/White/Gaussian → zero-mean, symmetric
    if abs(mean_val) < 5 and skew_val < 0.5:
        return "Gaussian"
    
    # Quantization → discrete steps
    diffs = np.diff(np.unique(img_noisy))
    if np.any(diffs > 1) and np.all(diffs % 16 == 0):
        return "Quantization"
    
    return "Additive"  # fallback

def best_filter_for_noise(noise_type):
    mapping = {
        "Gaussian": gaussian_filter,
        "Impulse": median_filter,
        "Poisson": harmonic_filter,
        "Exponential": harmonic_filter,
        "Gamma": harmonic_filter,
        "Rayleigh": mean_filter,
        "Uniform": averaging_filter,
        "White": gaussian_filter,
        "Colored": midpoint_filter,
        "Additive": mean_filter,
        "Multiplicative": geometric_filter,
        "Quantization": midpoint_filter,
        "Photon": harmonic_filter
    }
    return mapping.get(noise_type, mean_filter)

def denoise_image(img_noisy, img_original):
    noise_type = identify_noise(img_noisy, img_original)
    print(f"Identified noise: {noise_type}")
    filter_func = best_filter_for_noise(noise_type)
    denoised = filter_func(img_noisy)
    return denoised, noise_type

if __name__ == "__main__":
    img_original = cv2.imread("Original.png", cv2.IMREAD_GRAYSCALE)
    img_noisy = cv2.imread("Gaussian.png", cv2.IMREAD_GRAYSCALE)  # change to any noisy image
    
    denoised, noise_type = denoise_image(img_noisy, img_original)
    
    cv2.imwrite(f"denoised_{noise_type}.png", denoised)

    import matplotlib.pyplot as plt
    plt.figure(figsize=(12,5))
    plt.subplot(1,3,1)
    plt.imshow(img_original, cmap="gray")
    plt.title("Original")
    plt.axis("off")
    
    plt.subplot(1,3,2)
    plt.imshow(img_noisy, cmap="gray")
    plt.title(f"Noisy ({noise_type})")
    plt.axis("off")
    
    plt.subplot(1,3,3)
    plt.imshow(denoised, cmap="gray")
    plt.title("Denoised")
    plt.axis("off")
    
    plt.tight_layout()
    plt.show()


